# Ontolite configuration. Copy to .env (git-ignored).
# Ontolite itself needs no API keys. Keys are only for the optional benchmark/collection workflow.
ONTOLITE_DB=./ontolite.db
ONTOLITE_AUDIT_LOG=./audit.jsonl
# Principal the MCP server acts as when started over stdio
ONTOLITE_PRINCIPAL=analyst
# SEC requires a descriptive User-Agent with contact info for data downloads
SEC_USER_AGENT=Your Name your.email@example.com
NVIDIA_API_KEY=your-nvidia-key-here
GROQ_API_KEY=your-groq-key-here
