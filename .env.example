# Ontolite configuration. Copy to .env (git-ignored). No API keys are needed to run or test Ontolite.
ONTOLITE_BACKEND=sqlite              # sqlite (default, OLTP) | duckdb (analytics)
ONTOLITE_DB=./ontolite.db
ONTOLITE_AUDIT_LOG=./audit.jsonl
ONTOLITE_AUDIT_KEY=./audit.key       # Ed25519 private key for signed tree heads (create: ontolite audit keygen)
ONTOLITE_TOKENS=./tokens.json        # bearer-token digests for the HTTP transport (ontolite token issue)
ONTOLITE_PRINCIPAL=analyst           # fixed principal for the stdio transport
SEC_USER_AGENT=Your Name your.email@example.com   # SEC requires a descriptive User-Agent with contact info
# Only for real-model benchmark runs (inspect eval ... -T solver=agent):
NVIDIA_API_KEY=your-nvidia-key-here
GROQ_API_KEY=your-groq-key-here
